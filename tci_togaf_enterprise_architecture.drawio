<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-20T07:00:00.000Z" agent="Hermes Enterprise Architect" version="24.0.0" type="device"><diagram id="p1-overview" name="1. TOGAF 總體企業架構藍圖"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;b&gt;大江生醫 企業級 TOGAF 資訊架構總體藍圖&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;font-weight:normal;color:#475569;'&gt;TCI Biomedical TOGAF 10 Enterprise Architecture Master Blueprint&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;fontSize=20;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1370" height="45" as="geometry" /></mxCell><mxCell id="3" value="架構主持：Howard Liao Ph.D.  |  涵蓋：業務架構 (Business)、數據架構 (Data Bus/DataHub)、應用架構 (HowardAGent/HowardPro) 與技術架構 (APISIX/Noname/HowardRoute)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=0;fontSize=12;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="1370" height="25" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;【TOGAF 業務架構層】Business Architecture&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="95" width="1370" height="175" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;【核心價值鏈與戰略能力】&lt;/b&gt;&lt;br&gt;• 生醫配方研發與專利設計 (R&amp;amp;D)&lt;br&gt;• 生物發酵與植萃智能製造 (CDMO/ODM)&lt;br&gt;• 全球多廠供應鏈與國際市場銷售&lt;br&gt;• GMP / ISO / TFDA 國際法規嚴格合規" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="135" width="420" height="120" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;【四大立竿見影業務場景 (Quick Win)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;財務憑證&lt;/b&gt;：SAP 傳票 OCR 自動入帳與核銷&lt;br&gt;• &lt;b&gt;客服 KM&lt;/b&gt;：知識庫 RAG 第一線應答＋真人轉介&lt;br&gt;• &lt;b&gt;採購與勤採&lt;/b&gt;：費用申請、採購比對、異常核准&lt;br&gt;• &lt;b&gt;總務行政&lt;/b&gt;：人事與行政表單自動化流轉" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="135" width="420" height="120" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;【使用者角色矩陣 (Personas)】&lt;/b&gt;&lt;br&gt;• 2E 內部辦公：會計、總務、採購、研發工程師&lt;br&gt;• 2C/2B 客戶：全球品牌經銷商、終端消費者&lt;br&gt;• OT 現場：發酵調機專家、設備維護員、QC/QA&lt;br&gt;• 決策高層：C-Level 戰略與商業價值驗收" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="135" width="420" height="120" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;【TOGAF 應用系統與 AI 架構層】Application &amp;amp; AI Solution Architecture&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="285" width="1370" height="190" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;【企業核心營運系統】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;SAP ERP&lt;/b&gt;：財務會計、訂單、採購主幹&lt;br&gt;• &lt;b&gt;MES / WMS&lt;/b&gt;：製造執行系統與倉儲物流&lt;br&gt;• &lt;b&gt;SCADA / PLC&lt;/b&gt;：發酵萃取產線即時監控&lt;br&gt;• &lt;b&gt;既有資產&lt;/b&gt;：n8n 流程、ComfyUI 視覺流程" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="325" width="420" height="135" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;【應用中樞：HowardAGent (思邁智能)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Agentic RAG (95% 準確度)&lt;/b&gt;：生醫規章/SOP 帶來源引用&lt;br&gt;• &lt;b&gt;OCR Agent&lt;/b&gt;：財務傳票/發票自動化入帳&lt;br&gt;• &lt;b&gt;客服 Copilot&lt;/b&gt;：電話/LINE 多渠道第一線回覆&lt;br&gt;• &lt;b&gt;自有 MCP Hub&lt;/b&gt; &amp;amp; &lt;b&gt;Text2SQL&lt;/b&gt;：自然語言查數據庫" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="325" width="420" height="135" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;【工業決策與預測：HowardPro (杰倫智能)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;左腦 AutoML&lt;/b&gt;：發酵/萃取參數推薦、虛擬量測、PdM&lt;br&gt;• &lt;b&gt;右腦 AI Studio&lt;/b&gt;：Domain Twin (NPI/FAE/PMC 數位員工)&lt;br&gt;• &lt;b&gt;中樞 AILM&lt;/b&gt;：模型漂移監控、跨廠區經驗傳承&lt;br&gt;• &lt;b&gt;六道防線&lt;/b&gt;：Skill 掃描、ACL、全流程追蹤、Guardrail" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="325" width="420" height="135" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;【TOGAF 數據與資訊架構層】Data Architecture &amp;amp; Data Bus&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="490" width="1370" height="180" as="geometry" /></mxCell><mxCell id="13" value="&lt;b&gt;【雙環 Data Bus 數據總線】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;IT 企業骨幹總線&lt;/b&gt;：Apache Kafka (持久化/可重播)&lt;br&gt;• &lt;b&gt;OT 工業物聯網總線&lt;/b&gt;：EMQX (MQTT Sparkplug B) + OPC UA&lt;br&gt;• &lt;b&gt;即時異動捕捉 (CDC)&lt;/b&gt;：Debezium (無侵入監聽 SAP/MES Log)&lt;br&gt;• &lt;b&gt;串流清洗&lt;/b&gt;：Kafka Streams / Schema Registry 規格校驗" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="530" width="420" height="125" as="geometry" /></mxCell><mxCell id="14" value="&lt;b&gt;【數據治理與主數據中樞】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;元數據與血緣追蹤&lt;/b&gt;：DataHub (地端開源部署)&lt;br&gt;• &lt;b&gt;主數據管理 (MDM)&lt;/b&gt;：SAP MDG / LnData 數據中台&lt;br&gt;• 統一原料批號、客戶、供應商、產品 BOM 表規格&lt;br&gt;• 確保各系統與 AI 模型使用同一份標準乾淨數據" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="530" width="420" height="125" as="geometry" /></mxCell><mxCell id="15" value="&lt;b&gt;【生醫合規與數據安全 (ALCOA+)】&lt;/b&gt;&lt;br&gt;• 滿足 &lt;b&gt;GMP / FDA 21 CFR Part 11&lt;/b&gt; 電子紀錄與審計軌跡&lt;br&gt;• &lt;b&gt;WORM 原則&lt;/b&gt;：發酵原始 Raw Data 永久不可篡改&lt;br&gt;• &lt;b&gt;動態脫敏與權限隔離&lt;/b&gt;：Immuta / Row-Level Security&lt;br&gt;• 敏感個資 (PII) 與核心配方專利 Air-Gapped 隔離" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#92400E;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="530" width="420" height="125" as="geometry" /></mxCell><mxCell id="16" value="&lt;b&gt;【TOGAF 技術基礎設施與 API 資安層】Technology, API Platform &amp;amp; Security Architecture&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="685" width="1370" height="180" as="geometry" /></mxCell><mxCell id="17" value="&lt;b&gt;【API 平台與 Noname Security 資安防護】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;運行時網關&lt;/b&gt;：Apache APISIX (低延遲、動態熱更新)&lt;br&gt;• &lt;b&gt;身分鑑權&lt;/b&gt;：Keycloak (統一 OIDC / OAuth2 / SSO 認證)&lt;br&gt;• &lt;b&gt;Noname Security 核心防護&lt;/b&gt;：&lt;br&gt;  - 影子與殭屍 API 自動探索與清點&lt;br&gt;  - AI 行為基線監控，阻斷 OWASP API Top 10 (BOLA/越權)&lt;br&gt;  - CI/CD 測試左移主動驗證，保障生醫數據不出廠" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="725" width="420" height="125" as="geometry" /></mxCell><mxCell id="18" value="&lt;b&gt;【統一模型調度網關：HowardRoute Gateway】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;單一 OpenAI 標準端點&lt;/b&gt;：調度 250+ 款大模型&lt;br&gt;• &lt;b&gt;0% 加價 (Zero Markup)&lt;/b&gt;：原廠官方定價、統一發票&lt;br&gt;• &lt;b&gt;Smart Routing 智慧分流&lt;/b&gt;：簡單/複雜任務分發，省 20~40% 成本&lt;br&gt;• &lt;b&gt;高可用性防爆&lt;/b&gt;：保留容量抗 429、跨時區調度、毫秒級自動容災" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="725" width="420" height="125" as="geometry" /></mxCell><mxCell id="19" value="&lt;b&gt;【混合算力資源池與國際認證】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;雲端頂級商業模型&lt;/b&gt;：Claude 3.7 / GPT-4.5 / Gemini 2.5&lt;br&gt;• &lt;b&gt;地端私有算力叢集&lt;/b&gt;：DeepSeek R1/V3、Llama on 研華/雲達 GPU 伺服器&lt;br&gt;• &lt;b&gt;國際資安與隱私雙認證&lt;/b&gt;：ISO/IEC 27001:2022 + ISO/IEC 27701:2019&lt;br&gt;• &lt;b&gt;Zero Data Retention&lt;/b&gt;：提示詞記憶體過路不儲存，專利絕不拿來訓練" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="725" width="420" height="125" as="geometry" /></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="6" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="9" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="10" target="17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="11" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="17" target="18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="18" target="19"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p2-business" name="2. 業務架構視圖 (Business)"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;b&gt;TOGAF 業務架構視圖：大江生醫 價值鏈與 AI 賦能矩陣&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;font-weight:normal;color:#475569;'&gt;TCI Biomedical Value Stream &amp;amp; Capability Map&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;fontSize=20;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1370" height="45" as="geometry" /></mxCell><mxCell id="3" value="價值鏈導向：生醫研發 ➔ 採購供應 ➔ 發酵萃取智能製造 ➔ 品保合規 ➔ 全球營銷 ➔ 營運支撐 (財務/總務/人資)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=0;fontSize=12;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="1370" height="25" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;1. 研發與配方設計 (R&amp;D)&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="105" width="215" height="680" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;【核心業務活動】&lt;/b&gt;&lt;br&gt;• 活性天然物成分篩選&lt;br&gt;• 生醫製劑與保健品配方設計&lt;br&gt;• 臨床功效驗證與論文專利" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="50" y="155" width="195" height="230" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;【AI 賦能落地】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;研發專利知識庫 (HowardAGent KM)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;NPI Twin (試產 Gate Review)&lt;/b&gt;&lt;br&gt;• 研發團隊 Code Review 助理" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="50" y="415" width="195" height="230" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;2. 原物料採購 (Procurement)&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="271" y="105" width="215" height="680" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;【核心業務活動】&lt;/b&gt;&lt;br&gt;• 全球生化原物料尋源比價&lt;br&gt;• 供應商資質與證書審核&lt;br&gt;• 勤採與費用申請核銷" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="281" y="155" width="195" height="230" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;【AI 賦能落地】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;四大場景：採購自動化審核&lt;/b&gt;&lt;br&gt;• 異常價格與報銷偵測告警&lt;br&gt;• &lt;b&gt;PMC Twin (原物料交期風險)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="281" y="415" width="195" height="230" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;3. 發酵萃取製造 (Smart Mfg)&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="502" y="105" width="215" height="680" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;【核心業務活動】&lt;/b&gt;&lt;br&gt;• 發酵槽溫濕度與溶氧調控&lt;br&gt;• 萃取壓力與反應時間優化&lt;br&gt;• 跨國廠區 (屏東/上海) 生產" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="512" y="155" width="195" height="230" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;【AI 賦能落地】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;HowardPro 左腦：AutoML 參數推薦&lt;/b&gt;&lt;br&gt;• &lt;b&gt;生化指標虛擬量測 (VM)&lt;/b&gt;&lt;br&gt;• 機台設備預防保養 (PdM 預警)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="512" y="415" width="195" height="230" as="geometry" /></mxCell><mxCell id="13" value="&lt;b&gt;4. 品質與法規合規 (QA/QC)&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="733" y="105" width="215" height="680" as="geometry" /></mxCell><mxCell id="14" value="&lt;b&gt;【核心業務活動】&lt;/b&gt;&lt;br&gt;• 出廠批次生化指標檢驗&lt;br&gt;• GMP / ISO / TFDA 規範審計&lt;br&gt;• 偏差調查與客訴根因分析" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="743" y="155" width="195" height="230" as="geometry" /></mxCell><mxCell id="15" value="&lt;b&gt;【AI 賦能落地】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;SOP 與法規檢索 (Agentic RAG)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;AILM：RCA 根因改善追蹤&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ALCOA+ 數據不可篡改審計&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="743" y="415" width="195" height="230" as="geometry" /></mxCell><mxCell id="16" value="&lt;b&gt;5. 全球營銷與客服 (Sales/CX)&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="964" y="105" width="215" height="680" as="geometry" /></mxCell><mxCell id="17" value="&lt;b&gt;【核心業務活動】&lt;/b&gt;&lt;br&gt;• B2B 全球經銷商商務洽談&lt;br&gt;• B2C 終端消費者售後服務&lt;br&gt;• 國際生醫展會推廣" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="974" y="155" width="195" height="230" as="geometry" /></mxCell><mxCell id="18" value="&lt;b&gt;【AI 賦能落地】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;四大場景：客服回覆 Agent&lt;/b&gt;&lt;br&gt;• &lt;b&gt;AI AMAZE：電話/語音客服&lt;/b&gt;&lt;br&gt;• 展會多語雙向即時翻譯專員" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="974" y="415" width="195" height="230" as="geometry" /></mxCell><mxCell id="19" value="&lt;b&gt;6. 營運支撐 (Finance/GA)&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="1195" y="105" width="215" height="680" as="geometry" /></mxCell><mxCell id="20" value="&lt;b&gt;【核心業務活動】&lt;/b&gt;&lt;br&gt;• 財務會計傳票處理與結算&lt;br&gt;• 總務行政與差旅表單流轉&lt;br&gt;• 人事規章與同仁培訓" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1205" y="155" width="195" height="230" as="geometry" /></mxCell><mxCell id="21" value="&lt;b&gt;【AI 賦能落地】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;四大場景：財務傳票 OCR 入帳&lt;/b&gt;&lt;br&gt;• &lt;b&gt;四大場景：總務流程自動化&lt;/b&gt;&lt;br&gt;• 新進同仁「照著 Plan 做」迅速上手" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1205" y="415" width="195" height="230" as="geometry" /></mxCell><mxCell id="22" value="&lt;b&gt;【TOGAF 業務架構決策原則】&lt;/b&gt; 先以業務成果驗證（財務傳票 OCR、客服 KM、採購審核、總務行政），再擴展至產線發酵萃取預測；治理統一是目標，場景成果是門檻，成本估算是前提。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#FFFFFF;fillColor=#0F172A;strokeColor=#0F172A;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="810" width="1370" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p3-data" name="3. 數據與資訊架構視圖 (Data &amp; Bus)"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;b&gt;TOGAF 數據與資訊架構視圖：雙環 Data Bus 與治理藍圖&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;font-weight:normal;color:#475569;'&gt;TCI Biomedical Dual-Ring Data Bus &amp;amp; Governance Matrix&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;fontSize=20;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1370" height="45" as="geometry" /></mxCell><mxCell id="3" value="數據大動脈：OT 產線物聯網環 (EMQX) ＋ IT 企業事件骨幹環 (Kafka + Debezium) ＋ 全生命週期數據治理 (DataHub + ALCOA+)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=0;fontSize=12;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="1370" height="25" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;1. 多源數據產生源 (Data Sources)&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="105" width="325" height="680" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;【SAP ERP 核心業務庫】&lt;/b&gt;&lt;br&gt;• 財務會計傳票與核銷記錄&lt;br&gt;• 採購訂單、庫存與應付帳款&lt;br&gt;• 客戶、供應商主檔" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="150" width="295" height="100" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;【工廠 MES &amp;amp; SCADA 機台】&lt;/b&gt;&lt;br&gt;• 發酵槽秒級溫度、壓力、pH 數值&lt;br&gt;• 萃取釜感測流 (Sensors)&lt;br&gt;• 生產批次履歷與批次 BOM 表" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="270" width="295" height="100" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;【生醫研發與品保文檔】&lt;/b&gt;&lt;br&gt;• GMP / TFDA 規範與品保 SOP&lt;br&gt;• 專利研發實驗記錄與配方&lt;br&gt;• 歷史客訴與排障報告 (PDF/Office)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="390" width="295" height="100" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;【客戶進線與外部數據】&lt;/b&gt;&lt;br&gt;• 客服對話錄音與文字 Log (PBX/LINE)&lt;br&gt;• 供應商報價單與原廠 COA 檢驗報告" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="510" width="295" height="90" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;2. 雙環 Data Bus 數據總線&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="388" y="105" width="325" height="680" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;【OT 工業物聯網環：EMQX Broker】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;協議轉換&lt;/b&gt;：OPC UA / Modbus ➔ MQTT&lt;br&gt;• &lt;b&gt;工業標準&lt;/b&gt;：採用 Sparkplug B 規範&lt;br&gt;• 支援毫秒級併發採集發酵感測流&lt;br&gt;• 產線無網 (Air-Gapped) 單向泵送安全閘門" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="403" y="150" width="295" height="120" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;【IT 企業核心骨幹環：Apache Kafka】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;持久化儲存&lt;/b&gt;：保證零丟包 (Zero Loss)&lt;br&gt;• &lt;b&gt;事件可重播 (Replay)&lt;/b&gt;：支援回放離線訓練&lt;br&gt;• 核心 Topic：`telemetry.ferment`, `sap.voucher`&lt;br&gt;• &lt;b&gt;Schema Registry&lt;/b&gt;：強制校驗資料格式海關" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="403" y="290" width="295" height="130" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;【即時異動捕捉：Debezium CDC】&lt;/b&gt;&lt;br&gt;• 零侵入監聽 SAP / MES 資料庫交易日誌&lt;br&gt;• 異動 1 秒內轉化為事件流入 Kafka&lt;br&gt;• 不耗損 ERP 主伺服器運算效能" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="403" y="440" width="295" height="110" as="geometry" /></mxCell><mxCell id="13" value="&lt;b&gt;3. 數據治理與合規存儲&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="736" y="105" width="325" height="680" as="geometry" /></mxCell><mxCell id="14" value="&lt;b&gt;【元數據與血緣追蹤：DataHub】&lt;/b&gt;&lt;br&gt;• 地端開源部署，全公司資料目錄&lt;br&gt;• 自動化資料血緣 (Data Lineage) 追蹤&lt;br&gt;• 監控資料品質 (Data Quality) 與異常告警" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="751" y="150" width="295" height="115" as="geometry" /></mxCell><mxCell id="15" value="&lt;b&gt;【主數據管理 (MDM)：SAP MDG】&lt;/b&gt;&lt;br&gt;• 集中治理原料批號、客戶、物料主檔&lt;br&gt;• 消除一物多名，統一資料規格中台" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="751" y="285" width="295" height="95" as="geometry" /></mxCell><mxCell id="16" value="&lt;b&gt;【生醫合規數據庫 (ALCOA+)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;GMP / 21 CFR Part 11&lt;/b&gt; 審計日誌&lt;br&gt;• &lt;b&gt;WORM 特性&lt;/b&gt;：Raw Data 永久不可篡改&lt;br&gt;• &lt;b&gt;PostgreSQL / MinIO&lt;/b&gt; 地端數據湖" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="751" y="400" width="295" height="105" as="geometry" /></mxCell><mxCell id="17" value="&lt;b&gt;【動態脫敏與安全：Immuta】&lt;/b&gt;&lt;br&gt;• 欄位級動態遮蔽 (Masking)&lt;br&gt;• 確保核心配方與個資不外洩" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="751" y="525" width="295" height="80" as="geometry" /></mxCell><mxCell id="18" value="&lt;b&gt;4. AI 消費與決策終端&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="1084" y="105" width="325" height="680" as="geometry" /></mxCell><mxCell id="19" value="&lt;b&gt;【HowardPro 工業大腦】&lt;/b&gt;&lt;br&gt;• 訂閱發酵即時串流，執行虛擬量測&lt;br&gt;• 萃取參數最佳化推薦&lt;br&gt;• 歷史重播數據訓練 AutoML 模型" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1099" y="150" width="295" height="115" as="geometry" /></mxCell><mxCell id="20" value="&lt;b&gt;【HowardAGent 應用中樞】&lt;/b&gt;&lt;br&gt;• 訂閱 SAP CDC 事件，自動化財務 OCR&lt;br&gt;• 檢索生醫 SOP 向量庫，回覆客服問答&lt;br&gt;• Text2SQL 自然語言查詢業務數據" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1099" y="285" width="295" height="115" as="geometry" /></mxCell><mxCell id="21" value="&lt;b&gt;【管理與 BI 戰情室】&lt;/b&gt;&lt;br&gt;• 多廠區生產良率與能耗儀表板&lt;br&gt;• 財務營收與採購成本即時報表" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1099" y="420" width="295" height="95" as="geometry" /></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="6" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="10" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="5" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="12" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="11" target="14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="11" target="19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="11" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="29" value="&lt;b&gt;【TOGAF 數據架構核心價值】&lt;/b&gt; 建立雙環 Data Bus 解耦系統雜湊，確保生醫製造數據『一處發布、多處訂閱、零遺失、可回放』，並以 DataHub + ALCOA+ 滿足嚴苛生醫法規審查。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#FFFFFF;fillColor=#0F172A;strokeColor=#0F172A;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="810" width="1370" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p4-application" name="4. 應用與 AI 解決方案架構"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;b&gt;TOGAF 應用架構視圖：三方責任邊界與協同矩陣&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;font-weight:normal;color:#475569;'&gt;Application Portfolio &amp;amp; AI Solution Boundary&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;fontSize=20;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1370" height="45" as="geometry" /></mxCell><mxCell id="3" value="清楚劃分三方邊界，拒絕平台疊平台：HowardRoute 管模型 ｜ HowardAGent 管應用與知識 ｜ HowardPro 管工業預測 ｜ 大江生醫主導業務驗收" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=0;fontSize=12;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="1370" height="25" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;【應用層中樞：HowardAGent (思邁智能)】&lt;/b&gt;&lt;br&gt;定位：企業級生成式 AI 應用平台（辦公、知識與客服大腦）" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="105" width="440" height="680" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;【核心功能模組】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Agentic RAG (95% 準確度)&lt;/b&gt;：支援 25 種檔案格式，嚴格標註來源引用 (Citations)&lt;br&gt;• &lt;b&gt;OCR Agent&lt;/b&gt;：財務發票與憑證單據自動入帳&lt;br&gt;• &lt;b&gt;客服 Copilot&lt;/b&gt;：多渠道 (電話/LINE) 自動應答＋真人轉介&lt;br&gt;• &lt;b&gt;AI KM &amp;amp; HowardGPT&lt;/b&gt;：企業生醫 SOP 知識管理&lt;br&gt;• &lt;b&gt;自有 MCP Hub&lt;/b&gt;：標準化外部系統與 DB 串接&lt;br&gt;• &lt;b&gt;Text2SQL&lt;/b&gt;：自然語言查詢內部數據庫" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="160" width="410" height="190" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;【企業級資安與認證】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ISO/IEC 27001:2022&lt;/b&gt; 資訊安全管理認證&lt;br&gt;• &lt;b&gt;ISO/IEC 27701:2019&lt;/b&gt; 隱私資訊管理認證&lt;br&gt;• 六大 CI/CD 安全掃描 (SAST/DAST/Trivy)&lt;br&gt;• 攜手研華/雲達支援純地端私有化部署" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="370" width="410" height="130" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;【主責生醫場景】&lt;/b&gt;&lt;br&gt;• 財務憑證 OCR 自動入帳與跨系統核銷&lt;br&gt;• 客服知識庫第一線即時問答&lt;br&gt;• 採購與總務行政流程自動化" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="55" y="520" width="410" height="120" as="geometry" /></mxCell><mxCell id="8" value="&lt;b&gt;【模型調度網關：HowardRoute Gateway】&lt;/b&gt;&lt;br&gt;定位：統一 API 閘道與多模型智慧分流（流量與成本管道）" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="505" y="105" width="440" height="680" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;【核心功能模組】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;單一 OpenAI 標準端點&lt;/b&gt;：無縫切換 250+ 款大模型&lt;br&gt;• &lt;b&gt;0% 加價 (Zero Markup)&lt;/b&gt;：原廠官方定價、單一帳單&lt;br&gt;• &lt;b&gt;Smart Routing 智慧分流&lt;/b&gt;：&lt;br&gt;  - 簡單問題派發輕量模型 (Gemini Flash/DeepSeek)&lt;br&gt;  - 複雜推理派發頂級模型 (Claude/GPT-4.5)&lt;br&gt;  - &lt;b&gt;實測節省 20~40% Token 成本&lt;/b&gt;&lt;br&gt;• &lt;b&gt;毫秒級自動容災 (Auto-failover)&lt;/b&gt;&lt;br&gt;• 雲端保留容量抗 429 併發爆發" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="520" y="160" width="410" height="190" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;【數據安全與合規邊界】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Zero Data Retention&lt;/b&gt;：提示詞記憶體過路不儲存&lt;br&gt;• &lt;b&gt;Compliance Mode&lt;/b&gt;：鎖定美星合規節點&lt;br&gt;• 部門與個人配額限制 (Quota Management)&lt;br&gt;• 杜絕內部員工私自刷信用卡造成的資安漏洞" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="520" y="370" width="410" height="130" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;【主責職能】&lt;/b&gt;&lt;br&gt;• 統一收口全集團所有對外大模型請求&lt;br&gt;• 提供模型效能比較與 Token 成本分攤報表" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="520" y="520" width="410" height="120" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;【工業決策專家：HowardPro (杰倫智能)】&lt;/b&gt;&lt;br&gt;定位：製造業工業 AutoML 與領域數位分身（OT 預測大腦）" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="970" y="105" width="440" height="680" as="geometry" /></mxCell><mxCell id="13" value="&lt;b&gt;【核心功能模組】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;左腦 AutoML&lt;/b&gt;：無程式碼、Excel/CSV 1 週快速落地&lt;br&gt;  - 生醫發酵/萃取參數最佳化推薦&lt;br&gt;  - 活性成分虛擬量測 (Virtual Metrology)&lt;br&gt;  - 設備預防保養 (PdM) 預警&lt;br&gt;• &lt;b&gt;右腦 AI Studio&lt;/b&gt;：Domain Twin 領域數位分身&lt;br&gt;  - NPI Twin (試產 Gate Review)、FAE Twin、PMC Twin&lt;br&gt;• &lt;b&gt;中樞 AILM&lt;/b&gt;：全生命週期監控模型版本漂移 (Drift)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="985" y="160" width="410" height="190" as="geometry" /></mxCell><mxCell id="14" value="&lt;b&gt;【工業級安全防禦六道防線】&lt;/b&gt;&lt;br&gt;• Skill 安全掃描與 Prompt Injection 偵測&lt;br&gt;• ACL 權限隔離 &amp;amp; 全流程留痕追蹤 (Audit Trail)&lt;br&gt;• Block Ask 敏感詞即時攔截 &amp;amp; Guardrail 多模護欄&lt;br&gt;• &lt;b&gt;Air-Gapped 產線隔離&lt;/b&gt;：專利配方純地端運作" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFDF7;strokeColor=#B45309;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="985" y="370" width="410" height="130" as="geometry" /></mxCell><mxCell id="15" value="&lt;b&gt;【主責生醫場景】&lt;/b&gt;&lt;br&gt;• 屏東廠發酵槽產率提升與溫控參數優化&lt;br&gt;• 老師傅經驗數位化與跨廠區標準化複利" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#92400E;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="985" y="520" width="410" height="120" as="geometry" /></mxCell><mxCell id="16" value="&lt;b&gt;【TOGAF 應用協同原則】&lt;/b&gt; HowardRoute 管模型通路 ｜ HowardAGent 管辦公與客服知識 ｜ HowardPro 管產線物理預測 ｜ 大江生醫主導場景成果驗收；各司其職，發揮各產品最大商業價值。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#FFFFFF;fillColor=#0F172A;strokeColor=#0F172A;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="810" width="1370" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p5-security" name="5. 技術、API 平台與資安防護架構"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="&lt;b&gt;TOGAF 技術架構視圖：API 平台、Noname 資安與混合算力&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;font-weight:normal;color:#475569;'&gt;Technology Infrastructure, API Gateway, Noname Security &amp;amp; Hybrid Compute&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;fontSize=20;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1370" height="45" as="geometry" /></mxCell><mxCell id="3" value="立體縱深防禦：Apache APISIX 網關 ＋ Keycloak SSO ＋ Noname API 威脅偵測 ＋ 混合 GPU 算力池" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=0;fontSize=12;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="1370" height="25" as="geometry" /></mxCell><mxCell id="4" value="&lt;b&gt;【API 平台中樞與 Noname Security 資安防護層】&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="105" width="1370" height="280" as="geometry" /></mxCell><mxCell id="5" value="&lt;b&gt;【運行時 API 網關：Apache APISIX】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;極致效能&lt;/b&gt;：毫秒級轉發延遲 (&lt;1ms)，QPS 吞吐頂尖&lt;br&gt;• &lt;b&gt;動態熱更新&lt;/b&gt;：基於 etcd，變更路由策略零重啟、連線零中斷&lt;br&gt;• &lt;b&gt;微服務治理&lt;/b&gt;：負載均衡、熔斷降級、緩存、Rate Limiting 限流&lt;br&gt;• &lt;b&gt;MCP 工具適配&lt;/b&gt;：將 SAP/MES 接口封裝為 AI Agent 標準調用工具" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="145" width="420" height="140" as="geometry" /></mxCell><mxCell id="6" value="&lt;b&gt;【身分鑑權中樞：Keycloak (IAM)】&lt;/b&gt;&lt;br&gt;• 企業 Active Directory / LDAP 統一單一登入 (SSO)&lt;br&gt;• 標準 OpenID Connect (OIDC) &amp;amp; OAuth2 授權機制&lt;br&gt;• JWT Token 簽發與網關邊界秒級驗證&lt;br&gt;• RBAC 角色矩陣與生醫部門權限嚴格隔離" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="145" width="420" height="140" as="geometry" /></mxCell><mxCell id="7" value="&lt;b&gt;【API 資安防護大腦：Noname Security】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;影子與殭屍 API 探索&lt;/b&gt;：旁路鏡像自動清點全集團未知接口&lt;br&gt;• &lt;b&gt;AI 行為基線偵測&lt;/b&gt;：秒級識別合法身分越權 (BOLA/IDOR 攻擊)&lt;br&gt;• &lt;b&gt;OWASP API Top 10 全面防護&lt;/b&gt;：聯動 APISIX 即時阻斷惡意連線&lt;br&gt;• &lt;b&gt;CI/CD 測試左移&lt;/b&gt;：上線前執行 100+ 種滲透測試，守住生醫配方安全" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="145" width="420" height="140" as="geometry" /></mxCell><mxCell id="8" value="🔒 &lt;b&gt;API 防護聯動機制&lt;/b&gt;：Noname Security 採輕量旁路流量監聽（零延遲），一旦以 AI 偵測到 BOLA 越權或配方竊取，立即向 Apache APISIX 下發動態 ACL 黑名單阻斷。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFF1F2;strokeColor=#FDA4AF;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="300" width="1320" height="65" as="geometry" /></mxCell><mxCell id="9" value="&lt;b&gt;【混合算力基礎設施與模型資源池 (Compute &amp;amp; Foundation Models)】&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="405" width="1370" height="250" as="geometry" /></mxCell><mxCell id="10" value="&lt;b&gt;【地端私有算力叢集 (On-Prem GPU)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;硬體配置&lt;/b&gt;：研華科技 / 雲達科技 (QCT) 工業伺服器&lt;br&gt;• &lt;b&gt;NVIDIA GPU 算力&lt;/b&gt;：專供地端開源模型推論&lt;br&gt;• &lt;b&gt;私有模型&lt;/b&gt;：DeepSeek V3 / R1 推理模型、Qwen 2.5、Llama 3.3&lt;br&gt;• &lt;b&gt;推理引擎&lt;/b&gt;：vLLM / Ollama 高併發容器化部署&lt;br&gt;• &lt;b&gt;核心目標&lt;/b&gt;：財務機敏數據與核心配方不出廠" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="445" width="420" height="190" as="geometry" /></mxCell><mxCell id="11" value="&lt;b&gt;【模型調度樞紐：HowardRoute Gateway】&lt;/b&gt;&lt;br&gt;• 統一 OpenAI 相容端點，對接 250+ 款模型&lt;br&gt;• 0% Markup 原廠官方計費，免去各部門刷卡混亂&lt;br&gt;• &lt;b&gt;Smart Routing&lt;/b&gt;：依任務難易自動調度最適性價比模型&lt;br&gt;• 毫秒級自動容災轉移 (Failover) 與抗 429 保留容量" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="445" width="420" height="190" as="geometry" /></mxCell><mxCell id="12" value="&lt;b&gt;【雲端商業大模型池 (Public Cloud)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;頂級模型&lt;/b&gt;：Claude 3.7 Sonnet / Opus、GPT-4.5、Gemini 2.5&lt;br&gt;• &lt;b&gt;適用場景&lt;/b&gt;：多語客服即時對話、外文專利翻譯、複雜代碼審查&lt;br&gt;• &lt;b&gt;合規模式&lt;/b&gt;：鎖定美星合規節點，Prompt 記憶體過路不儲存&lt;br&gt;• &lt;b&gt;零資料保留&lt;/b&gt;：確保生醫數據不被回流用於模型訓練" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="445" width="420" height="190" as="geometry" /></mxCell><mxCell id="13" value="&lt;b&gt;【生醫網絡隔離架構與合規防禦邊界 (Security Boundaries)】&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="675" width="1370" height="180" as="geometry" /></mxCell><mxCell id="14" value="&lt;b&gt;【OT 工廠產線隔離網 (Air-Gapped)】&lt;/b&gt;&lt;br&gt;• 發酵槽 SCADA / PLC 機台完全實體或邏輯隔離&lt;br&gt;• 僅透過單向安全網閘向 IT 環發送 MQTT 數據&lt;br&gt;• 產線控制系統絕對不暴露於網際網路" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="715" width="420" height="120" as="geometry" /></mxCell><mxCell id="15" value="&lt;b&gt;【2E 企業辦公受控網 (Enterprise Intranet)】&lt;/b&gt;&lt;br&gt;• 財務會計、人資、研發團隊經由 VPN / SSO 存取&lt;br&gt;• 內建 DLP 敏感詞防護，防範專利配方外流&lt;br&gt;• 嚴格落實最小權限原則 (Principle of Least Privilege)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="715" width="420" height="120" as="geometry" /></mxCell><mxCell id="16" value="&lt;b&gt;【2C 外部對話 DMZ 隔離區 (Public DMZ)】&lt;/b&gt;&lt;br&gt;• 客服電話 (PBX) 與 LINE Bot 僅存取脫敏 FAQ&lt;br&gt;• 嚴禁外部流量穿透至核心 ERP 與製造資料庫&lt;br&gt;• 整合 Noname Security 防範撞庫與惡意爬蟲" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#92400E;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="715" width="420" height="120" as="geometry" /></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="5" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="5" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="11" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" edge="1" source="11" target="12"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p6-fsc" name="6. 上市櫃資安與金管會合規視圖"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c6_2" value="&lt;b&gt;大江生醫 上市櫃公司資通安全管控與金管會法規遵循視圖&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;font-weight:normal;color:#475569;'&gt;TWSE/TPEx Listed Company Cybersecurity &amp;amp; FSC GenAI Regulatory Compliance Architecture&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=1;fontSize=20;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="40" y="15" width="1370" height="45" as="geometry" /></mxCell><mxCell id="c6_3" value="法規依據：證券交易法、公開發行公司內控處理準則第9條之1、上市上櫃公司資通安全管控指引、金管會金融與上市企業使用生成式 AI 核心原則" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontStyle=0;fontSize=12;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="1370" height="25" as="geometry" /></mxCell><mxCell id="c6_4" value="&lt;b&gt;【1. 資安治理組織與內控制度】依法設置 CISO、董事會報告與 AI 風險治理內控&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="95" width="1370" height="230" as="geometry" /></mxCell><mxCell id="c6_5" value="&lt;b&gt;【依法設立專責資安組織】&lt;/b&gt;&lt;br&gt;• 依金管會內控準則，設置&lt;b&gt;資安長 (CISO)&lt;/b&gt; 與專責資安單位&lt;br&gt;• &lt;b&gt;董事會監督&lt;/b&gt;：資安長每年至少一次向董事會報告 AI 導入成效與資安態勢&lt;br&gt;• &lt;b&gt;內控制度更新&lt;/b&gt;：將生成式 AI 使用規範、API 平台與模型網關納入年度內控稽核" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="135" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_6" value="&lt;b&gt;【金管會生成式 AI 核心指引遵循】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;建立 AI 風險管理框架&lt;/b&gt;：明定 AI 生成內容之問責主體為企業本身&lt;br&gt;• &lt;b&gt;Human-in-the-Loop&lt;/b&gt;：財務傳票、採購審核重大決策禁止 AI 全自動閉環，必須設人工核准節點&lt;br&gt;• &lt;b&gt;可解釋性與溯源&lt;/b&gt;：嚴格要求 HowardAGent 輸出帶來源引用 (Citations)，杜絕 AI 幻覺導致法規責任" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="135" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_7" value="&lt;b&gt;【供應鏈與第三方委外資安管理】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;供應商稽核權&lt;/b&gt;：對 HowardAGent、HowardPro、HowardRoute 簽訂資安 SLA 與稽核條款&lt;br&gt;• &lt;b&gt;資安認證審查&lt;/b&gt;：優先採購具備 &lt;b&gt;ISO 27001 / 27701&lt;/b&gt; 國際認證之廠商&lt;br&gt;• &lt;b&gt;零資料保留條款&lt;/b&gt;：合約明定第三方模型嚴禁儲存 Raw Prompt，且絕不拿客戶數據進行模型訓練" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="135" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_8" value="&lt;b&gt;【2. 資通安全技術管控】落實證券交所《上市上櫃公司資通安全管控指引》&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="345" width="1370" height="230" as="geometry" /></mxCell><mxCell id="c6_9" value="&lt;b&gt;【縱深防禦與網絡隔離分段】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;OT 產線 Air-Gapped 隔離&lt;/b&gt;：發酵槽機台與 PLC 絕對隔離於網際網路之外&lt;br&gt;• &lt;b&gt;DMZ 隔離&lt;/b&gt;：外部客服進線 (PBX/LINE) 僅限存取脫敏 FAQ，禁止穿透核心庫&lt;br&gt;• &lt;b&gt;雙向單向閘門&lt;/b&gt;：OT 數據經由單向網閘泵送至 Kafka，杜絕橫向移動滲透" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="385" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_10" value="&lt;b&gt;【存取控制與身分防護 (Zero Trust)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;全面導入 MFA&lt;/b&gt;：員工存取 HowardAGent、API 平台與地端 GPU 伺服器強制多因子認證&lt;br&gt;• &lt;b&gt;特權帳號管理 (PAM)&lt;/b&gt;：嚴格管制資料庫與伺服器 Root/Admin 權限，操作完整錄影稽核&lt;br&gt;• &lt;b&gt;最小權限 (Least Privilege)&lt;/b&gt;：依 Keycloak RBAC 嚴格劃分財務、研發、生產權限" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="385" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_11" value="&lt;b&gt;【API 平台資安大腦：Noname Security】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;影子 API 探索&lt;/b&gt;：符合主管機關「資通資產盤點」要求，消滅未授權未知接口&lt;br&gt;• &lt;b&gt;運行時防禦&lt;/b&gt;：AI 基線偵測，即時阻斷 BOLA 越權攻擊與生醫專利資料刮取&lt;br&gt;• &lt;b&gt;漏洞管理左移&lt;/b&gt;：定期執行弱點掃描 (VA)、滲透測試 (Pen Test)，CI/CD 提前防堵" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="385" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_12" value="&lt;b&gt;【3. 業務持續營運 (BCP) 與重大資安事件申報】滿足證交所重大訊息發布要求&lt;/b&gt;" style="swimlane;html=1;fontStyle=1;align=left;spacingLeft=15;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=1.5;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="595" width="1370" height="230" as="geometry" /></mxCell><mxCell id="c6_13" value="&lt;b&gt;【高可用性與災難復原 (BCP/DRP)】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;指標要求&lt;/b&gt;：核心系統 RTO &amp;lt; 4 小時、RPO &amp;lt; 15 分鐘&lt;br&gt;• &lt;b&gt;3-2-1 備份原則&lt;/b&gt;：3 份資料、2 種介質、1 份異地/離線冷備份，嚴防勒索軟體 (Ransomware)&lt;br&gt;• &lt;b&gt;HowardRoute 毫秒級容災&lt;/b&gt;：雲端大模型供應商故障時自動轉移至備援節點，確保生產零中斷" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="635" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_14" value="&lt;b&gt;【SOC / SIEM 全天候監控與 T-CAT 通報】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;7×24 即時告警&lt;/b&gt;：整合企業 SOC / SIEM，以 AI 智慧過濾分析 Level 1 警報&lt;br&gt;• &lt;b&gt;重大訊息申報 (MOPS)&lt;/b&gt;：發生重大資安事件，依法於知悉次一營業日開盤前發布重訊&lt;br&gt;• &lt;b&gt;主管機關應變&lt;/b&gt;：即時通報證交所/櫃買中心及「證券期貨資通安全聯合應變中心 (T-CAT)」" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="510" y="635" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_15" value="&lt;b&gt;【生醫資料完整性與個人資料保護】&lt;/b&gt;&lt;br&gt;• &lt;b&gt;個資法遵&lt;/b&gt;：個資外洩即時通報機制，全面配置 DLP 敏感個資遮蔽&lt;br&gt;• &lt;b&gt;ALCOA+ 數據完整性&lt;/b&gt;：發酵生產 Raw Data WORM 不可篡改，符合 GMP / 21 CFR Part 11&lt;br&gt;• &lt;b&gt;營業秘密保護&lt;/b&gt;：核心天然物發酵專利絕不上公有雲，以地端推論確保數據主權" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="960" y="635" width="420" height="175" as="geometry" /></mxCell><mxCell id="c6_16" value="&lt;b&gt;【上市櫃與金管會資安合規總結】&lt;/b&gt; 本架構全面對齊金管會《金融與上市企業使用生成式 AI 核心指引》與證交所《上市上櫃公司資通安全管控指引》；從組織治理 (CISO)、技術縱深 (MFA/Air-Gapped/Noname)、數據主權 (Zero Retention/ALCOA+) 到重訊通報與 BCP，確保大江生醫在推動前瞻 AI 轉型的同時，兼顧最嚴苛的資本市場資安合規標準。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#FFFFFF;fillColor=#0F172A;strokeColor=#0F172A;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="840" width="1370" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>